# Copy this file to .streamlit/secrets.toml and fill in your real values.
# On the VPS / Streamlit Cloud, set the same key in the app's secrets manager.
#
# GOOGLE_SERVICE_ACCOUNT must be the FULL service account JSON as a single-line
# (or triple-quoted) string.

GOOGLE_SERVICE_ACCOUNT = '''
{
  "type": "service_account",
  "project_id": "your-project-id",
  "private_key_id": "...",
  "private_key": "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n",
  "client_email": "...@...iam.gserviceaccount.com",
  "client_id": "...",
  "token_uri": "https://oauth2.googleapis.com/token"
}
'''
